# 复制为 .env.local 后填写；.env.local 不会被 Git 提交。
DEEPSEEK_API_KEY=your_deepseek_api_key

# 以下配置按需覆盖。
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# SERVER_PORT=8081
# JWT_SECRET=请填写至少32字节的随机字符串
# DB_URL=jdbc:mysql://localhost:3306/tianyan?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=Root_123456
# MYSQL_CONTAINER=mysql
# Windows 启动默认使用独立容器 agric-mysql、数据卷 agric-mysql-data 和端口 3307。
# MYSQL_PORT=3307
# MYSQL_IMAGE=mysql:8.4
# MYSQL_VOLUME=agric-mysql-data
# DB_NAME=tianyan
# 本地 Agent 默认接入 Ollama 中已安装的 Qwen2.5 7B。
# AGENT_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_MODEL=qwen2.5:7b
# AGENT_API_KEY=
# WEATHER_LATITUDE=38.07366
# WEATHER_LONGITUDE=116.56667
# 梨叶识别默认使用项目内 vision-runtime/.venv 的 Python，ONNX 推理在 CPU 运行。
# VISION_PYTHON=D:/Code/agric/vision-runtime/.venv/Scripts/python.exe
# VISION_STORAGE=D:/Code/agric/var/vision

# 本机显存繁忙时，setup-agent.ps1 -Cpu 创建共享权重的 CPU 运行配置。
# AGENT_MODEL=agric-qwen2.5:7b-cpu
# AGENT_TIMEOUT_SECONDS=600
## Edge resource limits; desktop defaults shown. Jetson preset lives in deploy/jetson.
AGENT_WORKERS=2
AGENT_CAPACITY=4
AGENT_CONTEXT_TOKENS=8192
AGENT_MAX_TOKENS=768
VISION_BACKEND=onnx-cpu
VISION_TIMEOUT_SECONDS=120
AUTH_REGISTRATION_ENABLED=true
## Multi-crop service remains independent; start-multicrop.cmd launches the authenticated proxy's backend.
MULTICROP_BASE_URL=http://127.0.0.1:8090
# MULTICROP_PYTHON=D:/Code/agric/vision-runtime/.venv/Scripts/python.exe
# MULTICROP_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MULTICROP_LLM_MODEL=agric-qwen2.5:7b-cpu
