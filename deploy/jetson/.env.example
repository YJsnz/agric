# Copy with init-env.sh. Absolute paths are used by systemd.
DB_NAME=agric
DB_USERNAME=agric
DB_PASSWORD=replace-with-random-secret
MYSQL_ROOT_PASSWORD=replace-with-another-random-secret
DB_URL="jdbc:mysql://127.0.0.1:3307/agric?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
JWT_SECRET=replace-with-at-least-32-random-bytes
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
AUTH_REGISTRATION_ENABLED=true
AGENT_ENGINE=harness
AGENT_BASE_URL=http://127.0.0.1:8083/v1
AGENT_API_KEY=replace-with-random-secret
AGENT_MODEL=qwen3-4b-edge
AGENT_WORKERS=1
AGENT_CAPACITY=2
AGENT_CONTEXT_TOKENS=4096
AGENT_MAX_TOKENS=512
AGENT_TIMEOUT_SECONDS=600
LLAMA_MODEL=/var/lib/agric/models/Qwen3-4B-Q4_K_M.gguf
LLAMA_GPU_LAYERS=99
LLAMA_BATCH=128
LLAMA_UBATCH=64
VISION_PYTHON=/opt/agric/current/vision-runtime/jetson-venv/bin/python
VISION_BACKEND=tensorrt
VISION_ENGINE=/var/lib/agric/models/pear-leaf-fp16.engine
VISION_STORAGE=/var/lib/agric/vision
VISION_LOG_DIRECTORY=/var/lib/agric/logs
VISION_TIMEOUT_SECONDS=120
VISION_CPU_THREADS=2
# Opt in only after CUDA parity + model accuracy validation on the target board.
VISION_PREPROCESS=pillow
VISION_CUDA_LIBRARY=/opt/agric/current/vision-runtime/cuda/build/libagric_cuda.so
