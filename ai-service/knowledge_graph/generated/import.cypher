MATCH (a:KGEntity {id: "review25:6f5bdaf47e6aafdb"}), (b:KGEntity {id: "review25:471c22d952c37dcb"}) MERGE (a)-[r:ASSOCIATED_WITH {id: "review25:e008"}]->(b) SET r += {id: "review25:e008", kind: "association", evidence_ids: ["paper_yali_2025"], claim: "缓冷条件下，中期采收组贮藏末期硬度保持较好。", locator: "3.1；Figure 1D", crop: "v2:ea3447edac86e42f", region: "河北省", stage_ids: ["v2:1df599bacfb4d6d5"], scope: "general_pear", review_status: "transfer_pending", evidence_level: "B", confidence: null, effect_size: null, conditions: ["研究样品来自河北辛集，不是泊头田间或冷库验证；仅供研究参考，不直接转为生产操作指令。", "花后145/155/165天分组；12℃预冷24小时、每5天降2℃，30天降至0±0.5℃；湿度80%～85%；比较180～210天结果。", "不能据此独立估计缓冷相对快冷的效应；未读取原始个体数据。"], valid_from: "", valid_to: "", dataset: "pear_evidence_v2"};
