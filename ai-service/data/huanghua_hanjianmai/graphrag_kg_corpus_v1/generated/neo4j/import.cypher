MERGE (n:KGEntity {id:'soil:coastal_saline'}) SET n += {name: '滨海盐碱土', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'SoilType'}, n:SoilType;
MERGE (n:KGEntity {id:'soil:low_organic'}) SET n += {name: '有机质含量低土壤', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'SoilType'}, n:SoilType;
MERGE (n:KGEntity {id:'stress:drought'}) SET n += {name: '干旱胁迫', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'Stress'}, n:Stress;
