// ============ 黄骅旱碱麦 KG V1 导入 ============
// crop_id = huanghua_hanjianmai , dataset = hanjianmai_evidence_v1
// 仅轮换本 crop 的旧快照，不影响泊头鸭梨(pear_evidence_v2)。
MATCH ()-[r]->() WHERE r.dataset = "hanjianmai_evidence_v1" SET r.dataset = "retired_hanjianmai_evidence_v1";
MATCH (n:KGEntity) WHERE n.dataset = "hanjianmai_evidence_v1" AND n.crop = "huanghua_hanjianmai" SET n.dataset = "retired_hanjianmai_evidence_v1";
MATCH (s:KGStatement) WHERE s.dataset = "hanjianmai_evidence_v1" AND s.crop = "huanghua_hanjianmai" SET s.dataset = "retired_hanjianmai_evidence_v1";
CREATE CONSTRAINT kg_statement_id IF NOT EXISTS FOR (s:KGStatement) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT kg_entity_id IF NOT EXISTS FOR (n:KGEntity) REQUIRE n.id IS UNIQUE;
MERGE (n:KGEntity {id:'crop:wheat'}) SET n += {name: '黄骅旱碱麦', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'Crop'}, n:Crop;
MERGE (n:KGEntity {id:'reg:binhai'}) SET n += {name: '渤海湾滨海盐碱区', region: 'binhai', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'Region'}, n:Region;
MERGE (n:KGEntity {id:'env:salinity'}) SET n += {name: '土壤盐分', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'EnvironmentFactor'}, n:EnvironmentFactor;
MERGE (n:KGEntity {id:'soil:saline_alkali'}) SET n += {name: '中度盐碱地', region: '', description: '', crop: 'huanghua_hanjianmai', dataset: 'hanjianmai_evidence_v1', node_type: 'SoilType'}, n:SoilType;
