MATCH ()-[r]->() WHERE r.dataset="hanjianmai_evidence_v1" SET r.dataset="retired_hanjianmai_evidence_v1";
MATCH (n:KGEntity) WHERE n.dataset="hanjianmai_evidence_v1" SET n.dataset="retired_hanjianmai_evidence_v1";
